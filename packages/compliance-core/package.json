{
  "name": "@attestly/compliance-core",
  "version": "0.1.3",
  "description": "Zero-latency, Web Standard-based SDK that enforces AI compliance",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Attestly-dev/attestly-oss.git",
    "directory": "packages/compliance-core"
  },
  "bugs": {
    "url": "https://github.com/Attestly-dev/attestly-oss/issues"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
